<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Amber Glowing Frosted Body with Refraction Rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/status_wait_bg" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/status_wait_border" />
        </shape>
    </item>
    <!-- Multi-Tone Dynamic Glass Reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFAB00"
                android:centerColor="#10FF6D00"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
