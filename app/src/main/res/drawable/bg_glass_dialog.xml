<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Modal Dialog Surface with Acceptable Transparency (~95% Opacity) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_dialog_glass" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_card_stroke_bright" />
        </shape>
    </item>
    <!-- Specular Light Reflection Gradient (Top Highlight for Liquid Glass Depth) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_specular_gradient_mid"
                android:endColor="@color/glass_specular_gradient_end"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
