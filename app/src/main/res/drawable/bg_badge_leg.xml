<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2600E5FF" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#6600E5FF" />
            <padding
                android:left="10dp"
                android:top="4dp"
                android:right="10dp"
                android:bottom="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
