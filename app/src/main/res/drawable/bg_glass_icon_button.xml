<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple_white">
    <item>
        <selector>
            <!-- Pressed State -->
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <solid android:color="#4DFFFFFF" />
                            <stroke
                                android:width="1.5dp"
                                android:color="#99FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <!-- Default Translucent Glass Circle Pod -->
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <solid android:color="@color/glass_btn_std_bg" />
                            <stroke
                                android:width="1dp"
                                android:color="@color/glass_btn_std_stroke" />
                        </shape>
                    </item>
                    <!-- Specular Top Rim Reflection -->
                    <item>
                        <shape android:shape="oval">
                            <gradient
                                android:angle="270"
                                android:startColor="#40FFFFFF"
                                android:centerColor="#10FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:type="linear" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
